---
import ArticleList from '../../components/ArticleList.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('essays');
---
<ArticleList title="Essays" seoTitle="随笔与长文" description="路遥知玛丽的长文与随笔，记录个人观察、生活经验和阶段性的思考。" collection="essays" posts={posts} toggle>
  写给需要时间消化的内容。<br />更像长文、记录和阶段性判断，不追求一次说完。
</ArticleList>
