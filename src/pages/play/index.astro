---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Play · 路遥知玛丽" description="代码实验与交互游戏">
  <section class="play-page">
    <header class="page-header">
      <h1>Play</h1>
      <p class="subtitle">代码实验与交互游戏</p>
    </header>

    <div class="game-wrapper">
      <div class="game-card">
        <div class="game-info">
          <h2>NES Rockman 1987</h2>
          <p>基于 jsnes 的经典洛克人 ROM 封装，支持键盘操控与金手指。</p>
        </div>
        <div class="game-frame">
          <iframe
            src="/play/game.html"
            title="NES Rockman 1987"
            allow="autoplay"
            sandbox="allow-scripts allow-same-origin"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    background: var(--color-bg);
    color: var(--color-text-heading);
  }

  .play-page {
    width: min(1100px, 100%);
  }

  .page-header {
    margin: var(--space-56) 0 var(--space-48);
    padding: 0 var(--space-20);
  }

  .page-header h1 {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-page);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-8);
  }

  .subtitle {
    font-size: var(--text-summary);
    color: var(--color-text-secondary);
  }

  .game-wrapper {
    padding: 0 var(--space-20);
    margin-bottom: var(--space-120);
  }

  .game-card {
    border: var(--divider-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
  }

  .game-info {
    padding: var(--space-24) var(--space-28) var(--space-16);
  }

  .game-info h2 {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--text-heading-3);
    font-weight: var(--weight-normal);
    margin: 0 0 var(--space-8);
  }

  .game-info p {
    font-size: var(--text-intro);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .game-frame {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #111217;
    border-top: var(--divider-subtle);
  }

  .game-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  @media (max-width: 720px) {
    .game-frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
