---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Play · 路遥知玛丽" description="代码实验与交互游戏">
  <section class="play-page">
    <header class="page-header">
      <h1>Play</h1>
      <p class="subtitle">代码实验与交互游戏</p>
    </header>

    <div class="game-wrapper">
      <div class="game-card">
        <div class="game-info">
          <h2>NES Rockman 1987</h2>
          <p>基于 jsnes 的经典洛克人 ROM 封装，支持键盘操控与金手指。</p>
        </div>
        <div class="game-frame">
          <iframe
            src="/play/game.html"
            title="NES Rockman 1987"
            allow="autoplay"
            sandbox="allow-scripts allow-same-origin"
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    background: #f6f4f0;
    color: #1f1c17;
  }

  .play-page {
    width: min(1100px, 100%);
  }

  .page-header {
    margin: 56px 0 48px;
    padding: 0 20px;
  }

  .page-header h1 {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    margin-bottom: 8px;
  }

  .subtitle {
    font-size: 16px;
    opacity: 0.6;
  }

  .game-wrapper {
    padding: 0 20px;
    margin-bottom: 120px;
  }

  .game-card {
    border: 1px solid rgba(31, 28, 23, 0.12);
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.7);
  }

  .game-info {
    padding: 24px 28px 16px;
  }

  .game-info h2 {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .game-info p {
    font-size: 14px;
    opacity: 0.6;
    margin: 0;
  }

  .game-frame {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #111217;
    border-top: 1px solid rgba(31, 28, 23, 0.08);
  }

  .game-frame iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  @media (max-width: 720px) {
    .game-frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
