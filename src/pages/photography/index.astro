---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// 使用 import.meta.glob 导入所有摄影图片（eager 模式直接获取模块）
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/photography/photo_*.jpg',
  { eager: true }
);

// 按文件名排序并提取图片元数据
const photos = Object.entries(imageModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);
---

<Layout>
  <main class="photography">
    <header class="photography-header">
      <h1>Photography</h1>
      <p class="intro">
        这里收录的是一些通过影像完成的记录。<br />
        它们并不试图解释世界，而是保留观看发生的瞬间。
      </p>
    </header>

    <section class="masonry" aria-label="摄影瀑布流">
      {photos.map((photo, index) => (
        <article class="card">
          <Image
            class="photo"
            src={photo}
            alt={`摄影 ${String(index + 1).padStart(2, '0')}`}
            widths={[400, 800, 1200]}
            sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
            format="webp"
            quality={80}
            loading="lazy"
            decoding="async"
          />
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>
  .photography {
    max-width: 1280px;
    margin: 56px auto 120px;
    padding: 0 20px;
  }

  .photography-header {
    margin-bottom: 48px;
  }

  .photography-header h1 {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    margin-bottom: 12px;
  }

  .intro {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.75;
  }

  .masonry {
    column-count: 4;
    column-gap: 16px;
  }

  .card {
    break-inside: avoid;
    margin: 0 0 16px;
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }

  @media (max-width: 1024px) {
    .masonry {
      column-count: 3;
    }
  }

  @media (max-width: 720px) {
    .masonry {
      column-count: 2;
    }
  }

  @media (max-width: 480px) {
    .masonry {
      column-count: 1;
    }
  }
</style>
