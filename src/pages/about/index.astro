---
import Layout from '../../layouts/Layout.astro';
import GuestbookSection from '../../components/GuestbookSection.astro';

const profile = {
  name: '路遥知玛丽',
  intro: '一个产品设计师，会点儿吉他，喜欢摄影，最近在研究 Ai。',
  sections: [
    {
      title: '我在做什么',
      body: [
        '从事产品与交互设计工作，',
        '具有系统化的设计教育背景，',
        '长期参与真实业务场景中的产品实践。',
      ],
    },
    {
      title: '',
      body: [
        '我的工作通常围绕复杂系统展开——',
        '从需求梳理、信息结构到交互与视觉表达，',
        '关注设计如何在限制条件中成立。',
      ],
    },
    {
      title: '我关心什么',
      body: [
        '除了设计工作本身，',
        '我也持续通过摄影与写作进行观察。',
        '相比结果，我更在意过程如何发生：',
        '一次决策、一段路径、一个被忽略的瞬间，',
        '往往比结论更有信息量。',
      ],
    },
    {
      title: '我怎么工作',
      body: [
        '我习惯通过可视化工具辅助思考与沟通，',
        '包括流程图、原型与界面系统，',
        '也在逐步将 AI 引入设计流程，',
        '用于探索、验证与降低表达成本。',
      ],
    },
  ],
  socials: [
    {
      name: '小红书',
      href: 'https://xhslink.com/m/6YY41S0QMoI',
    },
    {
      name: 'Instagram',
      href: 'https://www.instagram.com/luyao_owo/',
    },
  ],
  email: 'fly890611@163.com',
};
---

<Layout>
  <main class="about">
    <div class="portrait" role="presentation">
      <img src="/images/about/01.jpg" alt="" loading="lazy" decoding="async" />
    </div>
    <section class="content">
      <header class="intro">
        <h1>{profile.name}</h1>
        <p>{profile.intro}</p>
      </header>

      {profile.sections.map((section) => (
        <section class="block">
          {section.title ? <h2>{section.title}</h2> : null}
          {section.body.map((line) => (
            <p>{line}</p>
          ))}
        </section>
      ))}

      <section class="block contact">
        <h2>关注我</h2>
        <nav class="social-links" aria-label="社交平台">
          <details class="wechat-follow">
            <summary>微信公众号</summary>
            <div class="wechat-card">
              <img
                src="/images/wechat-qr.jpeg"
                alt="微信公众号二维码"
                width="140"
                height="140"
                loading="lazy"
              />
              <span>微信扫码关注</span>
            </div>
          </details>
          {profile.socials.map((social) => (
            <a href={social.href} target="_blank" rel="noreferrer">{social.name}</a>
          ))}
          <span class="email-follow">
            <button type="button" aria-describedby="email-address">邮箱</button>
            <span class="email-card" id="email-address" role="tooltip">{profile.email}</span>
          </span>
        </nav>
      </section>
    </section>
  </main>

  <div class="guestbook-wrap">
    <GuestbookSection />
  </div>
</Layout>

<style>
  .about {
    box-sizing: border-box;
    width: min(1120px, 100%);
    display: grid;
    grid-template-columns: minmax(280px, 1fr) minmax(320px, 1fr);
    gap: var(--space-48);
    margin: var(--space-56) auto var(--space-72);
    padding: 0 var(--space-20);
  }

  .guestbook-wrap {
    margin-top: var(--space-16);
    padding-bottom: var(--space-120);
  }

  .portrait {
    width: 100%;
  }

  .portrait img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-sm);
  }

  .content {
    display: grid;
    gap: var(--space-28);
  }

  .intro h1 {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-page);
    margin: 0 0 var(--space-12);
    letter-spacing: 0.02em;
  }

  .intro p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-text);
  }

  .block h2 {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-summary);
    margin: 0 0 var(--space-8);
    letter-spacing: 0.08em;
  }

  .block p {
    margin: 0 0 6px;
    line-height: var(--leading-text);
    color: var(--color-text);
  }

  .block p:last-child {
    margin-bottom: 0;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-20);
  }

  .social-links a,
  .wechat-follow summary,
  .email-follow button {
    color: var(--color-text-secondary);
    font-size: var(--text-body);
    line-height: var(--leading-text);
    text-decoration: underline;
    text-decoration-color: var(--color-link-underline);
    text-underline-offset: 0.2em;
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    transition: color 0.16s ease, text-decoration-color 0.16s ease, transform 0.1s ease;
  }

  .social-links a:hover,
  .wechat-follow summary:hover,
  .email-follow button:hover {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-underline-hover);
  }

  .social-links a:focus-visible,
  .wechat-follow summary:focus-visible,
  .email-follow button:focus-visible {
    outline: 2px solid var(--color-link-underline-hover);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .social-links a:active,
  .wechat-follow summary:active,
  .email-follow button:active {
    transform: translateY(1px);
  }

  .wechat-follow,
  .email-follow {
    position: relative;
  }

  .wechat-follow summary {
    list-style: none;
  }

  .wechat-follow summary::-webkit-details-marker {
    display: none;
  }

  .wechat-card {
    position: absolute;
    z-index: 1;
    top: calc(100% + var(--space-12));
    left: 0;
    display: grid;
    gap: var(--space-8);
    width: max-content;
    padding: var(--space-12);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
  }

  .wechat-card img {
    display: block;
    width: 140px;
    height: 140px;
  }

  .wechat-card span {
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    line-height: 1.4;
    text-align: center;
  }

  .email-card {
    position: absolute;
    z-index: 1;
    top: calc(100% + var(--space-12));
    right: 0;
    width: max-content;
    padding: var(--space-8) var(--space-12);
    color: var(--color-text-secondary);
    font-size: var(--text-summary);
    line-height: var(--leading-heading);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, visibility 0.16s ease, transform 0.16s ease;
  }

  .email-follow:hover .email-card,
  .email-follow:focus-within .email-card {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

    .portrait {
      max-width: 520px;
    }
  }

  @media (max-width: 540px) {
    .about {
      margin-top: var(--space-12);
    }

    .social-links {
      display: grid;
      grid-template-columns: max-content max-content max-content max-content;
      align-items: start;
      gap: var(--space-8) var(--space-16);
    }

    .wechat-card {
      position: static;
      margin-top: var(--space-8);
    }
  }
</style>
