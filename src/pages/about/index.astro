---
import Layout from '../../layouts/Layout.astro';
import WalineComments from '../../components/WalineComments.astro';

const profile = {
  name: '路遥知玛丽',
  intro: '一名产品设计师 / AI 产品经理。喜欢吉他、摄影，最近在研究 AI。',
  sections: [
    {
      title: 'My Journey',
      body: [
        '本科和硕士都学的是工业设计专业。',
        '毕业后进入一家医疗设备公司，到现在已经工作 6 年多。最开始做 UI 设计，后来逐渐开始做交互和产品设计，也开始接触更多复杂业务和 B 端产品。',
        'AI 出现之后，我也开始把注意力转到 AI 产品上，尝试推进 AI 和现有产品、业务流程的结合。',
      ],
    },
    {
      title: 'What I Do',
      body: [
        '现在主要做产品设计和产品方案。',
        '从前期需求分析、业务梳理，到产品方案、原型和设计，再到后面的开发跟进和落地，基本都会参与。',
        '做过移动端 App、小程序、H5，也做过 B 端后台，接触过不同类型的产品和业务。除了传统产品，也参与了 AI 产品相关的工作，包括智能体、AI 工作流以及一些 AI 应用。',
      ],
    },
    {
      title: "What I'm Exploring",
      body: [
        '最近主要在研究 AI 产品、Agent、AI Coding、RAG 和工作流。',
        '平时也会用 Claude Code、Codex 这些工具做需求拆解、文档整理、原型验证和一些简单的产品实验。在尝试发现 AI 能在哪些环节真正提高效率，以及人与 AI 之间的协作方式。',
      ],
    },
    {
      title: 'Beyond Work',
      body: [
        '喜欢弹吉他，有三把琴，一把是 Taylor 214CE，一把是圣马可 STA1000，一把是 Lava guitar。',
        '也喜欢摄影，有两个胶片相机和一个数码相机，平时拍得比较多的是人文和街头摄影，喜欢记录路上的人、光和一些很普通的瞬间。',
        '偶尔也会写点东西，发在公众号上，后来就搭了这个站。',
      ],
    },
  ],
  socials: [
    {
      name: '小红书',
      href: 'https://xhslink.com/m/6YY41S0QMoI',
    },
    {
      name: 'Instagram',
      href: 'https://www.instagram.com/luyao_owo/',
    },
  ],
  email: 'fly890611@163.com',
};
---

<Layout>
  <main class="about">
    <div class="portrait" role="presentation">
      <img src="/images/about/01.jpg" alt="" loading="lazy" decoding="async" />
    </div>
    <section class="content">
      <header class="intro">
        <h1>{profile.name}</h1>
        <p>{profile.intro}</p>
      </header>

      {profile.sections.map((section) => (
        <section class="block">
          {section.title ? <h2>{section.title}</h2> : null}
          {section.body.map((line) => (
            <p>{line}</p>
          ))}
        </section>
      ))}

      <section class="block contact">
        <h2>关注我</h2>
        <nav class="social-links" aria-label="社交平台">
          <details class="wechat-follow">
            <summary>微信公众号</summary>
            <div class="wechat-card">
              <img
                src="/images/wechat-qr.jpeg"
                alt="微信公众号二维码"
                width="140"
                height="140"
                loading="lazy"
              />
              <span>微信扫码关注</span>
            </div>
          </details>
          {profile.socials.map((social) => (
            <a href={social.href} target="_blank" rel="noreferrer">{social.name}</a>
          ))}
          <span class="email-follow">
            <button type="button" aria-describedby="email-address">邮箱</button>
            <span class="email-card" id="email-address" role="tooltip">{profile.email}</span>
          </span>
        </nav>
      </section>
    </section>
    <div class="about-rule" role="presentation"></div>
  </main>

  <WalineComments />
</Layout>

<style>
  .about {
    box-sizing: border-box;
    width: min(1120px, 100%);
    display: grid;
    /* 左列必须定宽：minmax 挨着 1fr 时会塌到基准值，长不上去 */
    grid-template-columns: clamp(320px, 32vw, 420px) minmax(0, 1fr);
    gap: var(--space-40);
    margin: var(--space-56) auto 0;
    padding: 0 var(--space-20);
  }

  /* 内容块与评论区之间的分割线。
     作为网格的一行横跨两栏，宽度自然和内容块对齐，不用重复算宽度。 */
  .about-rule {
    grid-column: 1 / -1;
    margin-top: var(--space-72);
    border-top: var(--divider-subtle);
  }

  .portrait {
    width: 100%;
    max-width: 420px;
  }

  .portrait img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-sm);
  }

  .content {
    display: grid;
    gap: var(--space-28);
  }

  .intro h1 {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    /* token 里 42px 往下直接跳到 22px，中间没有档，这一页单独取中间值 */
    font-size: clamp(24px, 2.4vw, 30px);
    margin: 0 0 var(--space-12);
    letter-spacing: 0.02em;
  }

  .intro p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: var(--leading-text);
  }

  .block h2 {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--text-summary);
    margin: 0 0 var(--space-8);
    letter-spacing: 0.08em;
  }

  .block p {
    margin: 0 0 var(--space-12);
    line-height: var(--leading-text);
    color: var(--color-text);
  }

  .block p:last-child {
    margin-bottom: 0;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-20);
  }

  .social-links a,
  .wechat-follow summary,
  .email-follow button {
    color: var(--color-text-secondary);
    font-size: var(--text-body);
    line-height: var(--leading-text);
    text-decoration: underline;
    text-decoration-color: var(--color-link-underline);
    text-underline-offset: 0.2em;
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    transition: color 0.16s ease, text-decoration-color 0.16s ease, transform 0.1s ease;
  }

  .social-links a:hover,
  .wechat-follow summary:hover,
  .email-follow button:hover {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-underline-hover);
  }

  .social-links a:focus-visible,
  .wechat-follow summary:focus-visible,
  .email-follow button:focus-visible {
    outline: 2px solid var(--color-link-underline-hover);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .social-links a:active,
  .wechat-follow summary:active,
  .email-follow button:active {
    transform: translateY(1px);
  }

  .wechat-follow,
  .email-follow {
    position: relative;
  }

  .wechat-follow summary {
    list-style: none;
  }

  .wechat-follow summary::-webkit-details-marker {
    display: none;
  }

  .wechat-card {
    position: absolute;
    z-index: 1;
    top: calc(100% + var(--space-12));
    left: 0;
    display: grid;
    gap: var(--space-8);
    width: max-content;
    padding: var(--space-12);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
  }

  .wechat-card img {
    display: block;
    width: 140px;
    height: 140px;
  }

  .wechat-card span {
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    line-height: 1.4;
    text-align: center;
  }

  .email-card {
    position: absolute;
    z-index: 1;
    top: calc(100% + var(--space-12));
    right: 0;
    width: max-content;
    padding: var(--space-8) var(--space-12);
    color: var(--color-text-secondary);
    font-size: var(--text-summary);
    line-height: var(--leading-heading);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-float);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, visibility 0.16s ease, transform 0.16s ease;
  }

  .email-follow:hover .email-card,
  .email-follow:focus-within .email-card {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 540px) {
    .about {
      margin-top: var(--space-12);
    }

    .social-links {
      display: grid;
      grid-template-columns: max-content max-content max-content max-content;
      align-items: start;
      gap: var(--space-8) var(--space-16);
    }

    .wechat-card {
      position: static;
      margin-top: var(--space-8);
    }
  }
</style>
