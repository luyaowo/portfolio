---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Guestbook · 路遥知玛丽" description="看看别人留下的话，也可以写一句。">
  <section class="guestbook-page">
    <header class="page-header">
      <p class="eyebrow">Guestbook</p>
      <h1>留言板</h1>
      <p class="subtitle">
        这里会放来访者留下的话，也欢迎你写一句。
      </p>
    </header>

    <div class="guestbook-grid">
      <section class="guestbook-panel">
        <div class="panel-head">
          <h2>Recent Messages</h2>
          <span id="guestbook-state">loading</span>
        </div>
        <div class="message-list" id="guestbook-list" aria-live="polite">
          <article class="message-card is-skeleton" aria-hidden="true">
            <div class="skeleton-line skeleton-line-wide"></div>
            <div class="skeleton-line skeleton-line-mid"></div>
            <div class="skeleton-line skeleton-line-short"></div>
          </article>
        </div>
      </section>

      <div class="guestbook-side">
        <aside class="guestbook-panel">
          <h2>留一句话</h2>
          <form class="guestbook-form" id="guestbook-form">
            <label class="field">
              <span>昵称</span>
              <input
                type="text"
                name="nickname"
                maxlength="24"
                autocomplete="nickname"
                placeholder="怎么称呼你"
                required
              />
            </label>

            <label class="field">
              <span>留言</span>
              <textarea
                name="message"
                rows="6"
                maxlength="500"
                placeholder="如果你愿意，可以在这里留下一句话。"
                required
              ></textarea>
            </label>

            <label class="honeypot" aria-hidden="true">
              <span>Website</span>
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>

            <div class="form-actions">
              <button type="submit" id="guestbook-submit">提交留言</button>
              <p class="form-status" id="guestbook-feedback">留言会在审核后展示。</p>
            </div>
          </form>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const listEl = document.getElementById('guestbook-list');
  const stateEl = document.getElementById('guestbook-state');
  const formEl = document.getElementById('guestbook-form');
  const feedbackEl = document.getElementById('guestbook-feedback');
  const submitEl = document.getElementById('guestbook-submit');
  const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });

  function setFeedback(message, type) {
    if (!feedbackEl) return;
    feedbackEl.textContent = message;
    feedbackEl.dataset.state = type;
  }

  function createMessageCard(message) {
    const article = document.createElement('article');
    article.className = 'message-card';

    const body = document.createElement('p');
    body.className = 'message-body';
    body.textContent = message.message;

    const meta = document.createElement('p');
    meta.className = 'message-meta';
    const rawDate = message.approved_at || message.created_at;
    const formattedDate = rawDate ? dateFormatter.format(new Date(rawDate)) : '';
    meta.textContent = formattedDate ? `${message.nickname} · ${formattedDate}` : message.nickname;

    article.append(body, meta);
    return article;
  }

  function renderFallback(message) {
    if (!listEl) return;
    listEl.innerHTML = '';

    const article = document.createElement('article');
    article.className = 'message-card is-muted';

    const body = document.createElement('p');
    body.className = 'message-body';
    body.textContent = message;

    const meta = document.createElement('p');
    meta.className = 'message-meta';
    meta.textContent = 'Guestbook';

    article.append(body, meta);
    listEl.append(article);
  }

  async function loadMessages() {
    if (!listEl || !stateEl) return;

    try {
      const response = await fetch('/api/guestbook', {
        headers: { accept: 'application/json' },
      });
      const result = await response.json();

      if (!response.ok || !result.ok) {
        stateEl.textContent = 'unavailable';
        renderFallback(result.message || '留言系统暂时不可用。');
        return;
      }

      const messages = Array.isArray(result.messages) ? result.messages : [];
      stateEl.textContent = `${messages.length} messages`;
      listEl.innerHTML = '';

      if (!messages.length) {
        renderFallback('还没有公开展示的留言。你可以成为第一位留下话的人。');
        return;
      }

      messages.forEach((message) => {
        listEl.append(createMessageCard(message));
      });
    } catch (_error) {
      stateEl.textContent = 'offline';
      renderFallback('留言系统暂时不可用。完成 Supabase 和环境变量配置后，这里会显示真实留言。');
    }
  }

  formEl?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const form = event.currentTarget;

    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    const formData = new FormData(form);
    submitEl?.setAttribute('disabled', 'true');
    setFeedback('正在提交...', 'pending');

    try {
      const response = await fetch('/api/guestbook', {
        method: 'POST',
        body: formData,
      });
      const result = await response.json();

      if (!response.ok || !result.ok) {
        throw new Error(result.message || '提交失败，请稍后再试。');
      }

      form.reset();
      setFeedback(result.message || '已收到，审核后会展示在这里。', 'success');
      await loadMessages();
    } catch (error) {
      const message = error instanceof Error ? error.message : '提交失败，请稍后再试。';
      setFeedback(message, 'error');
    } finally {
      submitEl?.removeAttribute('disabled');
    }
  });

  loadMessages();
</script>

<style>
  .guestbook-page {
    width: min(980px, 100%);
    margin: 56px auto 120px;
    padding: 0 20px;
  }

  .page-header {
    max-width: 640px;
    margin-bottom: 40px;
  }

  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
    margin: 0 0 14px;
  }

  .page-header h1 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.25;
    margin: 0 0 12px;
  }

  .subtitle {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.75;
    margin: 0;
  }

  .guestbook-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.9fr);
    gap: 24px;
    align-items: start;
  }

  .guestbook-side {
    display: grid;
    gap: 24px;
  }

  .guestbook-panel {
    border: 1px solid rgba(31, 28, 23, 0.12);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.72);
    padding: 24px;
  }

  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .panel-head h2,
  .guestbook-note h2 {
    font-size: 18px;
    margin: 0;
  }

  .panel-head span {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .message-list {
    display: grid;
    gap: 14px;
  }

  .message-card {
    padding: 18px;
    border-radius: 14px;
    background: rgba(246, 244, 240, 0.95);
    border: 1px solid rgba(31, 28, 23, 0.08);
  }

  .message-card.is-muted {
    opacity: 0.72;
  }

  .message-card.is-skeleton {
    display: grid;
    gap: 12px;
  }

  .skeleton-line {
    height: 10px;
    border-radius: 999px;
    background: rgba(31, 28, 23, 0.08);
  }

  .skeleton-line-wide {
    width: 88%;
  }

  .skeleton-line-mid {
    width: 72%;
  }

  .skeleton-line-short {
    width: 28%;
  }

  .message-body {
    margin: 0 0 12px;
    line-height: 1.8;
    font-size: 15px;
  }

  .message-meta {
    margin: 0;
    font-size: 13px;
    opacity: 0.5;
  }
  .guestbook-form {
    display: grid;
    gap: 18px;
    margin-top: 18px;
  }

  .field {
    display: grid;
    gap: 10px;
  }

  .field span {
    font-size: 14px;
    opacity: 0.72;
  }

  .field input,
  .field textarea {
    border: 1px solid rgba(31, 28, 23, 0.14);
    border-radius: 14px;
    background: rgba(246, 244, 240, 0.92);
    color: inherit;
    font: inherit;
    padding: 14px 16px;
    resize: vertical;
    box-sizing: border-box;
    width: 100%;
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid rgba(31, 28, 23, 0.18);
    outline-offset: 2px;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .form-actions {
    display: grid;
    gap: 10px;
  }

  .form-actions button {
    border: none;
    border-radius: 999px;
    background: #1f1c17;
    color: #f6f4f0;
    padding: 12px 18px;
    font: inherit;
    cursor: pointer;
    width: fit-content;
  }

  .form-actions button[disabled] {
    opacity: 0.5;
    cursor: wait;
  }

  .form-status {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.6;
  }

  .form-status[data-state='success'] {
    opacity: 0.82;
  }

  .form-status[data-state='error'] {
    opacity: 0.9;
  }

  @media (max-width: 800px) {
    .guestbook-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
