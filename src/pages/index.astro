---
import Layout from '../layouts/Layout.astro';

---

<Layout>
  <section class="home">
    <header class="intro">
      <p class="kicker">Design · Observation · Writing</p>
      <h1 class="title">
        我通过设计理解复杂系统，<br />
        也通过影像与文字记录那些无法被效率化的瞬间。
      </h1>
      <p class="desc">
        这里是一个长期更新的个人站点，用于沉淀设计思考、视觉记录与阶段性写作。
      </p>
    </header>

    <nav class="primary-nav" aria-label="主要内容入口">
      <a href="/work" class="nav-card">
        <strong>Work</strong>
        <span>设计作品与项目实践</span>
      </a>
      <a href="/design-study" class="nav-card">
        <strong>Design Study</strong>
        <span>设计原理与理论思考</span>
      </a>
      <a href="/ai-design" class="nav-card">
        <strong>Ai-practice</strong>
        <span>AI 工具评测与实践研究</span>
      </a>
      <a href="/ai" class="nav-card">
        <strong>Ai-image</strong>
        <span>生成式图像与视觉实验</span>
      </a>
      <a href="/essays" class="nav-card">
        <strong>Essays</strong>
        <span>长期思考与完整文章</span>
      </a>
      <a href="/photography" class="nav-card">
        <strong>Photography</strong>
        <span>摄影与视觉日记</span>
      </a>
      <a href="/play" class="nav-card">
        <strong>Play</strong>
        <span>写代码与交互游戏</span>
      </a>
      <a href="/about" class="nav-card">
        <strong>About</strong>
        <span>关于我、工作方式与联系</span>
      </a>
    </nav>
  </section>
</Layout>

<style>
  :global(body) {
    background: var(--color-bg);
    color: var(--color-text-heading);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .home {
    width: min(1200px, 100%);
  }

  .intro {
    max-width: 640px;
    margin: var(--space-56) auto var(--space-64);
    padding: 0 var(--space-20);
    text-align: left;
  }

  .kicker {
    font-size: var(--text-caption);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-16);
  }

  .title {
    color: var(--color-text-heading);
    font-family: var(--font-body);
    font-size: var(--text-title-article);
    line-height: var(--leading-meta);
    letter-spacing: 0;
    margin-bottom: var(--space-16);
    font-weight: var(--weight-semibold);
    text-wrap: balance;
  }

  .desc {
    font-size: var(--text-intro);
    line-height: var(--leading-text);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .primary-nav {
    max-width: var(--width-content);
    margin: 0 auto var(--space-120);
    padding: 0 var(--space-20);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-16);
  }

  .nav-card {
    border: var(--divider-subtle);
    border-radius: var(--radius-xl);
    padding: var(--space-28) var(--space-24);
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, var(--color-surface) 76%, transparent);
    transition: var(--transition-interactive);
    position: relative;
  }

  .nav-card strong {
    display: block;
    color: var(--color-text);
    font-size: var(--text-body);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-8);
  }

  .nav-card span {
    display: block;
    text-wrap: pretty;
    font-size: var(--text-intro);
    line-height: var(--leading-summary);
    color: color-mix(in srgb, var(--color-text-secondary) 80%, var(--color-text));
  }

  .nav-card:hover,
  .nav-card:focus-visible {
    background: var(--color-surface);
    transform: translateY(var(--translate-interactive-y));
    box-shadow: var(--shadow-float-soft);
  }

  @media (max-width: 720px) {
    .intro {
      margin: 80px auto 0;
    }

    .primary-nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-inline: 0;
      gap: var(--space-12);
    }

    .nav-card {
      padding: var(--space-24) var(--space-16);
    }

    .nav-card strong {
      font-size: clamp(var(--text-summary), 4.6vw, var(--text-body));
    }
  }
</style>
