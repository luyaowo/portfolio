---
import Layout from '../layouts/Layout.astro';

---

<Layout>
  <section class="home">
    <header class="intro">
      <p class="kicker">Design · Observation · Writing</p>
      <h1 class="title">
        我通过设计理解复杂系统，<br />
        也通过影像与文字记录那些无法被效率化的瞬间。
      </h1>
      <p class="desc">
        这里是一个长期更新的个人站点，用于沉淀设计思考、视觉记录与阶段性写作。
      </p>
    </header>

    <nav class="primary-nav" aria-label="主要内容入口">
      <a href="/essays" class="nav-card">
        <strong>Essays</strong>
        <span>长期思考与完整文章</span>
      </a>
      <a href="/notes" class="nav-card">
        <strong>Notes</strong>
        <span>碎片化想法与观察记录</span>
      </a>
      <a href="/photography" class="nav-card">
        <strong>Photography</strong>
        <span>摄影与视觉日记</span>
      </a>
      <a href="/work" class="nav-card">
        <strong>Work</strong>
        <span>设计项目与方法论</span>
      </a>
      <a href="/play" class="nav-card">
        <strong>Play</strong>
        <span>代码实验与交互游戏</span>
      </a>
      <a href="/ai" class="nav-card">
        <strong>Ai</strong>
        <span>生成式图像与视觉实验</span>
      </a>
    </nav>
  </section>
</Layout>

<style>
  :global(body) {
    background: #f6f4f0;
    color: #1f1c17;
  }

  .home {
    width: min(1200px, 100%);
  }

  .intro {
    max-width: 720px;
    margin: 120px auto 80px;
    padding: 0 20px;
  }

  .kicker {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.6;
    margin-bottom: 16px;
  }

  .title {
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.3;
    margin-bottom: 20px;
    font-weight: 700;
  }

  .desc {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.8;
  }

  .primary-nav {
    max-width: 900px;
    margin: 0 auto 120px;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .nav-card {
    border: 1px solid rgba(31, 28, 23, 0.12);
    border-radius: 16px;
    padding: 20px;
    text-decoration: none;
    color: inherit;
    background: rgba(255, 255, 255, 0.7);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .nav-card strong {
    display: block;
    font-size: 16px;
    margin-bottom: 6px;
  }

  .nav-card span {
    font-size: 14px;
    opacity: 0.7;
  }

  .nav-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(31, 28, 23, 0.12);
  }
</style>
