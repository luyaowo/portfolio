---
import { getCollection } from 'astro:content';
import EssayLayout from '../../layouts/EssayLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('ai-design');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, date, summary, cover } = post.data;
const articleClass = post.slug === "token" ? "essay-technical-longread" : undefined;
---

<EssayLayout summary={summary} cover={cover} publishedDate={date} collection="ai-design" currentSlug={post.slug} title={title} date={date} headings={headings} articleClass={articleClass}>
  <Content />
</EssayLayout>
