---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('design-study');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const formatDate = (value: Date) =>
  value.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'numeric',
    day: 'numeric',
  });
---

<Layout title="Design Study · 路遥知玛丽" description="设计原理、界面组件与研究笔记">
  <main class="list-page">
    <header class="list-header">
      <h1>Design Study</h1>
      <p class="intro">
        设计原理、界面组件与研究笔记。
      </p>
    </header>

    {sortedPosts.length === 0 && <p class="empty-state">文章整理中。</p>}

    <section class="item-list" aria-label="文章列表">
      {sortedPosts.map((post) => (
        <article class="item-row">
          <a class:list={['item-link', { 'without-cover': !post.data.cover }]} href={`/design-study/${post.slug}`}>
            {post.data.cover && (
              <figure class="cover">
                <img
                  src={post.data.cover.src}
                  width={post.data.cover.width}
                  height={post.data.cover.height}
                  alt={post.data.title}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}

            <div class="content">
              <div class="text">
                <h2 class="title">{post.data.title}</h2>
                {post.data.summary && <p class="summary">{post.data.summary}</p>}
              </div>

              <footer class="meta">
                <time class="date" datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
              </footer>
            </div>
          </a>
        </article>
      ))}
    </section>
  </main>
</Layout>

<style>
  .list-page {
    width: 100%;
    max-width: var(--width-content-narrow);
    margin: var(--space-56) auto var(--space-120);
    padding: 0 var(--space-20);
  }

  .list-header {
    margin-bottom: var(--space-48);
  }

  .list-header h1 {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-page);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-12);
  }

  .intro {
    margin: 0;
    font-size: var(--text-summary);
    line-height: var(--leading-text);
    color: var(--color-text-secondary);
  }

  .item-list {
    display: grid;
    gap: var(--space-48);
  }

  .empty-state {
    margin: 0;
    padding-top: var(--space-24);
    border-top: var(--divider-subtle);
    color: var(--color-text-secondary);
    font-size: var(--text-summary);
  }

  .item-link.without-cover {
    grid-template-columns: 1fr;
  }

  .without-cover .content {
    min-height: auto;
  }

  .item-link {
    display: grid;
    grid-template-columns: var(--size-cover-square) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: start;
    color: inherit;
    text-decoration: none;
  }

  .cover {
    margin: 0;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-hover);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .content {
    min-width: 0;
    display: grid;
    align-content: space-between;
    min-height: var(--size-cover-square);
  }

  .text {
    padding-top: 1px;
  }

  .title {
    margin: 0;
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-card);
    line-height: var(--leading-summary);
    font-weight: var(--weight-medium);
    letter-spacing: 0;
    text-wrap: balance;
  }

  .summary {
    margin: var(--space-8) 0 0;
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: var(--text-summary);
    line-height: var(--leading-summary);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-16);
    margin-top: var(--space-8);
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    line-height: var(--leading-meta);
  }

  .date {
    white-space: nowrap;
  }

  .item-link:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: var(--space-4);
  }

  @media (max-width: 960px) {
    .list-page {
      padding: 0 var(--space-20);
    }

    .item-link {
      grid-template-columns: var(--size-cover-square-md) minmax(0, 1fr);
      gap: var(--space-16);
    }

    .content {
      min-height: var(--size-cover-square-md);
    }

    .summary {
      font-size: var(--text-summary);
    }

    .meta {
      font-size: var(--text-caption);
    }
  }

  @media (max-width: 720px) {
    .list-page {
      margin-top: var(--space-28);
      padding: 0 var(--space-16);
    }

    .list-header {
      margin-bottom: var(--space-28);
    }

    .item-link {
      grid-template-columns: 1fr;
      gap: var(--space-16);
    }

    .cover {
      aspect-ratio: 16 / 10;
    }

    .content {
      min-height: auto;
      gap: var(--space-16);
    }

    .title {
      font-size: var(--text-heading-3);
    }

    .summary {
      font-size: var(--text-summary);
      line-height: var(--leading-text);
      margin-top: var(--space-8);
    }

    .meta {
      font-size: var(--text-meta);
      margin-top: 0;
    }
  }
</style>
