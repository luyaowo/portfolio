---
import ArticleList from '../../components/ArticleList.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('design-study');
---
<ArticleList
  title="Design Study"
  seoTitle="设计研习与界面组件"
  description="整理设计原理、界面组件与工具实践，记录产品设计中的理论思考和研究笔记。"
  collection="design-study"
  posts={posts}
  tags={['设计基础', '界面组件', '工具与实践']}
  toggle
>
  设计原理与理论思考。
</ArticleList>
