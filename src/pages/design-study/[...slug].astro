---
import { getCollection } from 'astro:content';
import EssayLayout from '../../layouts/EssayLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('design-study');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, date, summary, cover } = post.data;
---

<EssayLayout summary={summary} cover={cover} publishedDate={date} collection="design-study" currentSlug={post.slug} title={title} date={date} headings={headings}>
  <Content />
</EssayLayout>
