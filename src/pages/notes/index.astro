---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const sortedNotes = notes.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const renderedNotes = await Promise.all(
  sortedNotes.map(async (note) => ({
    note,
    Content: (await note.render()).Content,
  }))
);

const formatDate = (value: Date) =>
  value.toISOString().slice(0, 10).replaceAll('-', '/');
---

<Layout>
  <main class="notes">
    <header class="notes-header">
      <h1>Notes</h1>
      <p class="intro">
        这里记录一些小的想法，<br />
        它们来自生活或工作之间的思考。
      </p>
    </header>

    <ol class="note-list">
      {renderedNotes.map(({ note, Content }, index) => (
        <li class:list={['note-item', { 'is-first': index === 0, 'is-last': index === renderedNotes.length - 1 }]}>
          <div class="timeline-col">
            <span class="timeline-dot" />
            <span class="timeline-line" />
          </div>
          <div class="note-content">
            <time class="note-date" datetime={note.data.date.toISOString()}>
              {formatDate(note.data.date)}
            </time>
            <div class="note-body">
              <Content />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </main>
</Layout>

<style>
  .notes {
    max-width: var(--width-content-narrow);
    margin: var(--space-56) auto var(--space-120);
    padding: 0 var(--space-20);
    display: grid;
    gap: var(--space-48);
  }

  .notes-header h1 {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-page);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-12);
  }

  .intro {
    font-size: var(--text-summary);
    line-height: var(--leading-text);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .note-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* ── each note item: two-column grid ── */
  .note-item {
    display: grid;
    grid-template-columns: var(--space-24) 1fr;
    column-gap: var(--space-20);
  }

  /* ── timeline column: dot + line, stretches full height ── */
  .timeline-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
  }

  .timeline-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-text);
    opacity: var(--opacity-timeline-dot);
    flex-shrink: 0;
    margin-top: 5px;
  }

  .timeline-line {
    width: 1.5px;
    flex: 1 1 auto;
    min-height: var(--space-40);
    background: var(--color-border-strong);
    margin-top: var(--space-8);
  }

  /* hide line on last item */
  .note-item.is-last .timeline-line {
    visibility: hidden;
  }

  /* ── first item emphasis ── */
  .note-item.is-first .timeline-dot {
    width: 11px;
    height: 11px;
    opacity: var(--opacity-timeline-dot-active);
    margin-top: var(--space-4);
  }

  /* ── content area ── */
  .note-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-bottom: var(--space-40);
    min-width: 0;
  }

  .note-item.is-last .note-content {
    padding-bottom: 0;
  }

  .note-date {
    font-size: var(--text-intro);
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
    line-height: var(--leading-summary);
  }

  .note-body :global(p) {
    margin: 0;
    line-height: 1.9;
    color: var(--color-text);
    font-size: var(--text-summary);
  }

  .note-body :global(p + p) {
    margin-top: var(--space-8);
  }
</style>
