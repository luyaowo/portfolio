---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const sortedNotes = notes.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const renderedNotes = await Promise.all(
  sortedNotes.map(async (note) => ({
    note,
    Content: (await note.render()).Content,
  }))
);

const formatDate = (value: Date) =>
  value.toISOString().slice(0, 10).replaceAll('-', '/');
---

<Layout>
  <main class="notes">
    <header class="notes-header">
      <h1>Notes</h1>
      <p class="intro">
        这里记录一些小的想法，<br />
        它们来自生活或工作之间，<br />
        不刻意强求，只让情绪短暂停留。
      </p>
    </header>

    <ol class="note-list">
      {renderedNotes.map(({ note, Content }, index) => (
        <li class:list={['note-item', { 'is-first': index === 0, 'is-last': index === renderedNotes.length - 1 }]}>
          <div class="timeline-col">
            <span class="timeline-dot" />
            <span class="timeline-line" />
          </div>
          <div class="note-content">
            <time class="note-date" datetime={note.data.date.toISOString()}>
              {formatDate(note.data.date)}
            </time>
            <div class="note-body">
              <Content />
            </div>
          </div>
        </li>
      ))}
    </ol>
  </main>
</Layout>

<style>
  .notes {
    max-width: 720px;
    margin: 56px auto 120px;
    padding: 0 20px;
    display: grid;
    gap: 48px;
  }

  .notes-header h1 {
    font-size: 32px;
    margin: 0 0 12px;
  }

  .intro {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.75;
    margin: 0;
  }

  .note-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* ── each note item: two-column grid ── */
  .note-item {
    display: grid;
    grid-template-columns: 24px 1fr;
    column-gap: 20px;
  }

  /* ── timeline column: dot + line, stretches full height ── */
  .timeline-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
  }

  .timeline-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #1f1c17;
    opacity: 0.25;
    flex-shrink: 0;
    margin-top: 5px;
  }

  .timeline-line {
    width: 1.5px;
    flex: 1 1 auto;
    min-height: 40px;
    background: #1f1c17;
    opacity: 0.18;
    margin-top: 6px;
  }

  /* hide line on last item */
  .note-item.is-last .timeline-line {
    visibility: hidden;
  }

  /* ── first item emphasis ── */
  .note-item.is-first .timeline-dot {
    width: 11px;
    height: 11px;
    opacity: 0.9;
    margin-top: 4px;
  }

  /* ── content area ── */
  .note-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 40px;
    min-width: 0;
  }

  .note-item.is-last .note-content {
    padding-bottom: 0;
  }

  .note-date {
    font-size: 14px;
    letter-spacing: 0.04em;
    opacity: 0.5;
    line-height: 1.6;
  }

  .note-body :global(p) {
    margin: 0;
    line-height: 1.9;
    opacity: 0.85;
    font-size: 16px;
  }

  .note-body :global(p + p) {
    margin-top: 8px;
  }
</style>
