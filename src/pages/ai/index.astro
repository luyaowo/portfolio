---
import Layout from '../../layouts/Layout.astro';
import AIGallery from '../../components/AIGallery.astro';
import { aiGallery } from '../../data/ai-gallery';
---

<Layout title="Ai 图像 · 路遥知玛丽" description="这里收录一些由模型参与生成的图像实验。">
  <section class="ai-page">
    <header class="ai-header">
      <h1>Ai-image</h1>
      <p class="intro">
        这里收录一些由模型参与生成的图像实验。<br />
        它们既是视觉草图，也是对风格、材质与图像表达方式的持续探索。
      </p>
    </header>

    <AIGallery images={aiGallery} />
  </section>
</Layout>

<style>
  .ai-page {
    max-width: 960px;
    margin: var(--space-56) auto var(--space-120);
    padding: 0 var(--space-20);
  }

  .ai-header {
    margin-bottom: var(--space-48);
  }

  .ai-header h1 {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-page);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-12);
  }

  .intro {
    font-size: var(--text-summary);
    line-height: var(--leading-text);
    color: var(--color-text-secondary);
  }
</style>
