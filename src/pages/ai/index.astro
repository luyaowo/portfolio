---
import Layout from '../../layouts/Layout.astro';
import AIGallery from '../../components/AIGallery.astro';
import { aiGallery } from '../../data/ai-gallery';
---

<Layout title="AI · 路遥知玛丽" description="这里收录一些由模型参与生成的图像实验。">
  <section class="ai-page">
    <header class="ai-header">
      <h1>Ai</h1>
      <p class="intro">
        这里收录一些由模型参与生成的图像实验。<br />
        它们既是视觉草图，也是对风格、材质与图像表达方式的持续探索。
      </p>
    </header>

    <AIGallery images={aiGallery} />
  </section>
</Layout>

<style>
  .ai-page {
    max-width: 960px;
    margin: 56px auto 120px;
    padding: 0 20px;
  }

  .ai-header {
    margin-bottom: 48px;
  }

  .ai-header h1 {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    margin: 0 0 12px;
  }

  .intro {
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.75;
  }
</style>
