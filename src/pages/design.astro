---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Design Tokens · 路遥知玛丽">
  <style>
    .design-page {
      width: min(var(--width-content), 100%);
      margin: var(--space-56) auto var(--space-120);
      padding: 0 var(--space-20);
    }
    .design-page h1 {
      font-size: var(--text-title-page);
      font-weight: var(--weight-normal);
      margin: 0 0 var(--space-8);
    }
    .section {
      margin: var(--space-48) 0;
    }
    .section h2 {
      font-size: var(--text-heading-1);
      font-weight: var(--weight-normal);
      line-height: var(--leading-heading);
      margin: 0 0 var(--space-16);
      padding-bottom: var(--space-8);
      border-bottom: var(--divider-subtle);
    }
    .section h3 {
      font-size: var(--text-heading-2);
      font-weight: var(--weight-normal);
      margin: var(--space-32) 0 var(--space-12);
      color: var(--color-text-secondary);
    }

    /* ---- COLORS ---- */
    .swatch-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: var(--space-12);
    }
    .swatch {
      border: var(--divider-subtle);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .swatch-preview {
      height: var(--space-56);
    }
    .swatch-info {
      padding: var(--space-8) var(--space-12);
      font-size: var(--text-caption);
      line-height: var(--leading-meta);
    }
    .swatch-name {
      font-weight: var(--weight-semibold);
      color: var(--color-text);
    }
    .swatch-value {
      color: var(--color-text-tertiary);
      margin-top: var(--space-4);
      font-family: var(--font-mono);
      font-size: 11px;
    }

    /* ---- TYPOGRAPHY ---- */
    .type-sample {
      margin: var(--space-16) 0;
      padding: var(--space-12) 0;
      border-bottom: var(--divider-subtle);
    }
    .type-label {
      font-size: var(--text-caption);
      color: var(--color-text-tertiary);
      font-family: var(--font-mono);
      margin-bottom: var(--space-4);
    }
    .type-label span {
      color: var(--color-text-secondary);
      margin-left: var(--space-8);
    }

    /* ---- SPACING ---- */
    .space-demo {
      display: flex;
      align-items: center;
      gap: var(--space-12);
      margin: var(--space-4) 0;
    }
    .space-bar {
      background: var(--color-text-heading);
      height: var(--space-20);
      border-radius: var(--radius-sm);
      opacity: 0.25;
      flex-shrink: 0;
    }
    .space-label {
      font-size: var(--text-caption);
      color: var(--color-text-tertiary);
      font-family: var(--font-mono);
      white-space: nowrap;
    }

    /* ---- WEIGHTS ---- */
    .weight-sample {
      margin: var(--space-8) 0;
      font-size: var(--text-heading-1);
    }
  </style>

  <div class="design-page">
    <h1>Design Tokens</h1>
    <p style="font-size:var(--text-intro);color:var(--color-text-secondary);margin:0;">
      所有 token 定义在 <code>src/layouts/Layout.astro</code> 的 <code>:root</code> 中。
    </p>

    <!-- ====== COLORS ====== -->
    <div class="section">
      <h2>颜色 Colors</h2>

      <h3>背景 / 表面</h3>
      <div class="swatch-grid">
        {[
          ['--color-bg','#f7f6f2'],
          ['--color-surface','#fbfaf7'],
          ['--color-surface-white','#ffffff'],
        ].map(([name, hex]) => (
          <div class="swatch">
            <div class="swatch-preview" style={`background:${hex};`}></div>
            <div class="swatch-info">
              <div class="swatch-name">{name}</div>
              <div class="swatch-value">{hex}</div>
            </div>
          </div>
        ))}
      </div>

      <h3>文字</h3>
      <div class="swatch-grid">
        {[
          ['--color-text','rgba(48,48,46,0.94)'],
          ['--color-text-heading','rgba(20,20,19,0.99)'],
          ['--color-text-secondary','rgba(94,93,89,0.82)'],
          ['--color-text-tertiary','rgba(94,93,89,0.58)'],
          ['--color-text-inverse','rgba(248,245,237,0.96)'],
          ['--color-link','#8f4a38'],
          ['--color-link-hover','#6f3528'],
        ].map(([name, val]) => (
          <div class="swatch">
            <div class="swatch-preview" style={`background:${val};`}></div>
            <div class="swatch-info">
              <div class="swatch-name">{name}</div>
              <div class="swatch-value">{val}</div>
            </div>
          </div>
        ))}
      </div>

      <h3>边框 / 交互</h3>
      <div class="swatch-grid">
        {[
          ['--color-border','rgba(94,93,89,0.14)'],
          ['--color-border-strong','rgba(94,93,89,0.22)'],
          ['--color-interactive','rgba(20,20,19,0.98)'],
          ['--color-hover','rgba(94,93,89,0.055)'],
          ['--color-pressed','rgba(94,93,89,0.09)'],
          ['--color-code','rgba(94,93,89,0.08)'],
          ['--color-code-block','#181922'],
          ['--color-code-block-text','#f6f3ea'],
        ].map(([name, val]) => (
          <div class="swatch">
            <div class="swatch-preview" style={`background:${val};`}></div>
            <div class="swatch-info">
              <div class="swatch-name">{name}</div>
              <div class="swatch-value">{val}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ====== TYPOGRAPHY ====== -->
    <div class="section">
      <h2>排版 Typography</h2>

      <h3>字号 Font Size</h3>
      {[
        ['--text-caption','12px','最小的标注文字'],
        ['--text-meta','13px','元信息、日期'],
        ['--text-intro','14px','引导文字、图片说明'],
        ['--text-summary','16px','摘要'],
        ['--text-body','18px','正文段落'],
        ['--text-heading-3','20px','h4'],
        ['--text-heading-2','24px','h3'],
        ['--text-heading-1','30px','h1, h2'],
        ['--text-title-card','clamp(18,1.7vw,22)','列表卡片标题'],
        ['--text-title-page','clamp(28,4vw,42)','页面标题'],
        ['--text-title-article','clamp(34,4.8vw,42)','文章大标题'],
      ].map(([name, val, desc]) => (
        <div class="type-sample">
          <div class="type-label">{name} <span>{val} — {desc}</span></div>
          <div style={`font-size:var(${name});line-height:var(--leading-heading);color:var(--color-text);`}>
            设计让复杂变得清晰
          </div>
        </div>
      ))}

      <h3>字重 Font Weight</h3>
      <div class="weight-sample" style="font-weight:var(--weight-normal);">--weight-normal (500) 设计让复杂变得清晰</div>
      <div class="weight-sample" style="font-weight:var(--weight-semibold);">--weight-semibold (600) 设计让复杂变得清晰</div>
      <div class="weight-sample" style="font-weight:var(--weight-semibold);">--weight-bold (700) 设计让复杂变得清晰</div>

      <h3>行高 Line Height</h3>
      {[
        ['--leading-title','1.28','文章大标题'],
        ['--leading-meta','1.4','元信息'],
        ['--leading-heading','1.45','标题'],
        ['--leading-summary','1.62','摘要'],
        ['--leading-text','1.7','引导/说明文字'],
        ['--leading-body','1.82','正文'],
      ].map(([name, val, desc]) => (
        <div class="type-sample">
          <div class="type-label">{name} <span>{val} — {desc}</span></div>
          <div style={`font-size:var(--text-body);line-height:${val};color:var(--color-text);max-width:480px;`}>
            一个人可以不依附平台，完整地掌控自己的表达空间。网页始终是一种非常有力量的载体。
          </div>
        </div>
      ))}
    </div>

    <!-- ====== SPACING ====== -->
    <div class="section">
      <h2>间距 Spacing</h2>
      {[4,8,12,16,20,24,28,32,40,48,56,64,72,120].map(n => (
        <div class="space-demo">
          <div class="space-bar" style={`width:${n}px;`}></div>
          <div class="space-label">--space-{n}</div>
        </div>
      ))}
    </div>

    <!-- ====== RADIUS ====== -->
    <div class="section">
      <h2>圆角 / 阴影 / 宽度</h2>
      <div class="type-sample">
        <div class="type-label">--radius-sm: 4px</div>
        <div style="width:80px;height:40px;background:var(--color-text-heading);opacity:0.12;border-radius:4px;"></div>
      </div>
      <div class="type-sample">
        <div class="type-label">--radius-md: 8px</div>
        <div style="width:80px;height:40px;background:var(--color-text-heading);opacity:0.12;border-radius:8px;"></div>
      </div>
      <div class="type-sample">
        <div class="type-label">--radius-lg: 10px</div>
        <div style="width:80px;height:40px;background:var(--color-text-heading);opacity:0.12;border-radius:10px;"></div>
      </div>
      <div class="type-sample">
        <div class="type-label">--radius-xl: 12px</div>
        <div style="width:80px;height:40px;background:var(--color-text-heading);opacity:0.12;border-radius:12px;"></div>
      </div>
      <div class="type-sample">
        <div class="type-label">--shadow-float</div>
        <div style="width:120px;height:60px;background:var(--color-surface);border-radius:var(--radius-md);box-shadow:var(--shadow-float);"></div>
      </div>
      <div class="type-sample">
        <div class="type-label">--shadow-float-soft</div>
        <div style="width:120px;height:60px;background:var(--color-surface);border-radius:var(--radius-md);box-shadow:var(--shadow-float-soft);"></div>
      </div>
      <div class="type-sample">
        <div class="type-label">
          --width-content: 980px · --width-content-narrow: 760px · --width-article: 860px · --width-toc: 260px
        </div>
      </div>
    </div>
  </div>
</Layout>
