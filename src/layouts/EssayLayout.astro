---
import Layout from './Layout.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { getImage } from 'astro:assets';

const { title, date, headings = [], articleClass, summary, cover, publishedDate, collection, currentSlug } = Astro.props;
const shareImage = cover && typeof cover !== 'string'
  ? await getImage({ src: cover, width: Math.min(1200, cover.width), format: 'jpeg', quality: 85 })
  : undefined;
const ogImage = shareImage?.src ?? (typeof cover === 'string' ? cover : undefined);
const formattedDate =
  date instanceof Date
    ? date.toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })
    : date;
const tocHeadings = headings.filter((heading: { depth: number }) =>
  heading.depth === 1 || heading.depth === 2
);
const hasToc = tocHeadings.length >= 3;
---

<Layout title={`${title} · 路遥知玛丽`} description={summary} ogImage={ogImage}
  ogType="article" ogImageWidth={shareImage?.attributes.width} ogImageHeight={shareImage?.attributes.height}
  publishedTime={publishedDate?.toISOString()}>

  <div class:list={['essay-shell', { 'has-toc': hasToc }]}>
    <article class:list={["essay", articleClass]}>
      <header class="essay-header">
        <h1 class="essay-title">{title}</h1>
        {date && <time class="essay-date" datetime={publishedDate?.toISOString()}>{formattedDate}</time>}
      </header>
      {hasToc && (
        <details class="essay-toc-mobile">
          <summary>文章目录</summary>
          <nav aria-label="文章目录">
            {tocHeadings.map((heading: { slug: string; text: string }) => (
              <a class="essay-toc-link" href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </details>
      )}
      <div class="essay-body">
        <slot />
      </div>
      {collection && <div class="essay-related"><RelatedArticles collection={collection} excludeSlug={currentSlug} limit={2} heading="继续阅读" /></div>}
    </article>

    {
      hasToc && (
        <aside class="essay-toc" aria-label="文章目录">
          <nav class="essay-toc-nav">
            {tocHeadings.map((heading: { depth: number; slug: string; text: string }) => (
              <a class:list={['essay-toc-link', `depth-${heading.depth}`]} href={`#${heading.slug}`}>
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>
</Layout>

<style>
  .essay-shell {
    position: relative;
    width: min(var(--width-article), 100%);
    margin: var(--space-32) auto var(--space-72);
  }

  .essay {
    width: 100%;
    box-sizing: border-box;
    background: transparent;
    border-radius: 0;
    padding: 18px var(--space-16) 52px;
  }

  .essay-header {
    width: min(100%, var(--width-article-text));
    margin-inline: auto;
    margin-bottom: var(--space-32);
  }

  .essay-title {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-article);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-title-article);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-16);
  }

  .essay-date {
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    line-height: var(--leading-meta);
  }

  .essay-body {
    color: var(--color-text);
    font-family: var(--font-body);
    font-weight: var(--weight-normal);
    letter-spacing: 0;
    line-height: var(--leading-article-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-autospace: ideograph-alpha ideograph-numeric;
  }

  .essay-body :global(p) {
    font-family: inherit;
    font-weight: inherit;
    font-size: var(--text-article-body);
    line-height: var(--leading-article-body);
    margin: var(--space-article-paragraph) 0 0;
  }

  .essay-body :global(p:has(> img:only-child)) {
    width: min(100%, var(--width-article-text));
    margin: var(--space-article-media) auto;
  }

  .essay-body :global(p:has(> img:only-child) + p:has(> img:only-child)) {
    margin-top: -14px;
  }

  .essay-body :global(img) {
    width: 100%;
    height: auto;
    max-height: 68vh;
    object-fit: contain;
    display: block;
    margin: 0;
  }

  .essay-body :global(figure) {
    width: min(100%, var(--width-article-text));
    margin: var(--space-article-media) auto;
  }

  .essay-body :global(figure img) {
    margin: 0;
  }

  .essay-body :global(figcaption) {
    font-family: inherit;
    margin-top: var(--space-12);
    color: var(--color-text-tertiary);
    font-size: var(--text-intro);
    line-height: var(--leading-text);
    text-align: center;
  }

  .essay-body :global(hr) {
    border: 0;
    border-top: var(--divider-strong);
    margin: var(--space-48) 0;
  }

  .essay-body :global(h1),
  .essay-body :global(h2) {
    scroll-margin-top: 96px;
    color: var(--color-text-heading);
    font-family: var(--font-heading);
  }

  .essay-body :global(h1) {
    font-size: var(--text-heading-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-article-heading);
    margin: var(--space-56) 0 0;
    letter-spacing: -0.012em;
  }

  .essay-body :global(h2) {
    font-size: var(--text-heading-2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-article-heading);
    margin: var(--space-48) 0 0;
    letter-spacing: -0.008em;
  }

  .essay-body :global(h3) {
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--text-heading-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-article-heading);
    margin: var(--space-40) 0 0;
  }

  .essay-body :global(h4) {
    color: var(--color-text);
    font-size: var(--text-article-body);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-article-body);
    margin: var(--space-32) 0 0;
  }

  .essay-body :global(ul),
  .essay-body :global(ol) {
    margin: var(--space-article-paragraph) 0 0;
    padding-left: 1.4em;
  }

  .essay-body :global(ul) {
    padding-left: 1.25em;
  }

  .essay-body :global(ul li::marker) {
    color: var(--color-text-tertiary);
  }

  .essay-body :global(li) {
    font-family: inherit;
    font-weight: inherit;
    font-size: var(--text-article-body);
    line-height: var(--leading-article-body);
    margin: var(--space-8) 0 0;
  }

  .essay-body :global(ul > li + li) {
    margin-top: var(--space-12);
  }

  .essay-body :global(ol > li + li) { margin-top: var(--space-12); }
  .essay-body :global(ol > li::marker) { color: var(--color-text-secondary); font-variant-numeric: tabular-nums; }
  .essay-body :global(li > p) { margin-top: var(--space-8); }
  .essay-body :global(blockquote ol),
  .essay-body :global(blockquote ul) { margin-top: var(--space-12); }

  .essay-body :global(strong) {
    font-weight: var(--weight-semibold);
  }

  .essay-body :global(a) {
    color: var(--color-link);
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.18s ease, text-decoration-color 0.18s ease;
  }

  .essay-body :global(a:hover),
  .essay-body :global(a:focus-visible) {
    color: var(--color-link-hover);
    text-decoration-color: var(--color-link-underline-hover);
  }

  .essay-body :global(code) {
    border: 1px solid color-mix(in srgb, var(--color-link) 18%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-link) 7%, transparent);
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.12em 0.34em;
  }

  .essay-body :global(pre) {
    overflow-x: auto;
    margin: var(--space-article-media) 0;
    padding: var(--space-16) var(--space-20);
    background: var(--color-code-block);
    color: var(--color-code-block-text);
    font-size: var(--text-intro);
    line-height: var(--leading-article-body);
  }

  .essay-body :global(pre code) {
    border: 0;
    border-radius: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font-size: inherit;
  }

  .essay-body :global(blockquote) {
    margin: var(--space-article-media) 0;
    padding: var(--space-16) var(--space-20);
    border: var(--divider-subtle);
    border-radius: var(--radius-lg);
    color: var(--color-text-secondary);
    font-style: normal;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
  }

  .essay-body :global(blockquote p) {
    margin: 0 0 10px;
  }

  .essay-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .essay-body :global(blockquote strong) {
    color: var(--color-text-heading);
  }

  .essay-body :global(table) {
    width: min(100%, var(--width-article-text));
    margin: var(--space-article-media) auto;
    border: var(--divider-subtle);
    border-collapse: separate;
    border-spacing: 0;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 88%, transparent);
    font-size: 15px;
    line-height: 1.6;
    overflow: hidden;
  }

  .essay-body :global(th),
  .essay-body :global(td) {
    padding: var(--space-12) var(--space-16);
    border-bottom: var(--divider-subtle);
    text-align: left;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .essay-body :global(th) {
    background: var(--color-hover);
    color: var(--color-text-heading);
    font-weight: var(--weight-semibold);
  }

  .essay-body :global(td) {
    color: var(--color-text-secondary);
  }

  .essay-body :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .essay-body :global(p:not(:has(> img:only-child))),
  .essay-body :global(h1),
  .essay-body :global(h2),
  .essay-body :global(h3),
  .essay-body :global(h4),
  .essay-body :global(ul),
  .essay-body :global(ol),
  .essay-body :global(pre),
  .essay-body :global(blockquote),
  .essay-body :global(hr),
  .essay-body :global(figcaption) {
    width: min(100%, var(--width-article-text));
    box-sizing: border-box;
    margin-inline: auto;
  }

  .essay-body > :global(:first-child) {
    margin-top: 0;
  }

  /* This article is diagram-heavy, so prose stays narrow while visual explanations can breathe. */
  .essay-technical-longread .essay-header {
    margin-bottom: var(--space-40);
  }

  .essay-technical-longread .essay-body > :global(p:first-child) {
    color: var(--color-text-heading);
    font-size: 18px;
    line-height: 1.82;
  }

  .essay-technical-longread .essay-body :global(h2) {
    margin-top: var(--space-72);
    padding-top: var(--space-28);
    border-top: var(--divider-strong);
  }

  .essay-technical-longread .essay-body :global(h2:first-of-type) {
    margin-top: var(--space-56);
    padding-top: 0;
    border-top: 0;
  }

  .essay-technical-longread .essay-body :global(h3) {
    margin-top: var(--space-40);
  }

  .essay-technical-longread .essay-body :global(p:has(> img:only-child)),
  .essay-technical-longread .essay-body :global(figure) {
    width: min(100%, var(--width-article-text));
    margin-block: var(--space-32);
  }

  .essay-technical-longread .essay-body :global(img) {
    max-height: 82vh;
  }

  .essay-toc {
    display: none;
  }

  .essay-toc-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
  }

  .essay-toc-link {
    display: block;
    overflow: hidden;
    padding: var(--space-8);
    border-radius: var(--radius-md);
    color: color-mix(in srgb, var(--color-text-secondary) 90%, transparent);
    font-size: var(--text-intro);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-title);
    text-decoration: none;
    white-space: normal;
    overflow-wrap: anywhere;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .essay-toc-link:hover,
  .essay-toc-link:focus-visible,
  .essay-toc-link.is-active {
    color: var(--color-text);
    background: var(--color-hover);
    outline: none;
  }

  .essay-toc-link.is-active {
    color: var(--color-text-heading);
    box-shadow: inset 2px 0 var(--color-link);
    font-weight: var(--weight-semibold);
  }

  .essay-toc-link.depth-2:not(.is-active) {
    padding-left: var(--space-8);
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
  }

  .essay-toc-mobile, .essay-related { width: min(100%, var(--width-article-text)); margin-inline: auto; }
  .essay-toc-mobile { box-sizing: border-box; margin-bottom: var(--space-28); border-block: var(--divider-subtle); }
  .essay-toc-mobile summary { cursor: pointer; padding: var(--space-16) 0; font-size: var(--text-summary); color: var(--color-text-secondary); }
  .essay-toc-mobile nav { padding-bottom: var(--space-16); }

  @media (min-width: 48em) {
    .essay-shell {
      margin-top: var(--space-40);
    }

    .essay {
      padding: var(--space-24) var(--space-16) 76px;
    }
  }

  @media (min-width: 88em) {
    .essay-toc-mobile { display: none; }
    .essay-shell.has-toc {
      display: grid;
      grid-template-columns: minmax(0, var(--width-article)) var(--width-toc);
      column-gap: var(--space-24);
      align-items: start;
      width: min(
        calc(var(--width-article) + var(--space-24) + var(--width-toc)),
        100%
      );
    }

    .essay-toc {
      display: block;
      width: var(--width-toc);
      height: 100%;
    }

    .essay-toc-nav {
      position: sticky;
      top: 88px;
      max-height: calc(100vh - 112px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (max-width: 720px) {
    .essay-shell {
      margin-top: var(--space-12);
    }

    .essay {
      border-radius: 0;
      padding: 18px 0 46px;
    }

    .essay-header {
      margin-bottom: var(--space-28);
    }

    .essay-title {
      font-size: 30px;
      line-height: 1.25;
    }

    .essay-body :global(p) {
      font-size: var(--text-article-body);
      line-height: 1.75;
      margin-top: var(--space-article-paragraph);
    }

    .essay-body :global(h1) {
      font-size: 26px;
      line-height: var(--leading-article-heading);
    }

    .essay-body :global(h2) {
      font-size: 22px;
      line-height: var(--leading-article-heading);
    }

    .essay-body :global(h3) {
      font-size: 19px;
      line-height: var(--leading-article-heading);
    }

    .essay-body :global(li) {
      font-size: var(--text-article-body);
      line-height: 1.75;
    }

    /* Keep multi-column comparisons readable without widening the page. */
    .essay-body :global(table) {
      display: block;
      width: 100%;
      overflow-x: auto;
      table-layout: auto;
      font-size: var(--text-intro);
      overscroll-behavior-inline: contain;
    }
    .essay-body :global(th), .essay-body :global(td) {
      min-width: var(--width-table-cell-min);
      padding: var(--space-12);
      overflow-wrap: normal;
    }

    .essay-body :global(img) {
      max-height: 50vh;
    }

    .essay-body :global(p:has(> img:only-child)),
    .essay-body :global(figure) {
      margin: var(--space-24) auto;
    }

    .essay-body :global(p:has(> img:only-child) + p:has(> img:only-child)) {
      margin-top: -12px;
    }

    .essay-body :global(figcaption) {
      font-size: var(--text-meta);
    }

    .essay-technical-longread .essay-header {
      margin-bottom: var(--space-32);
    }

    .essay-technical-longread .essay-body > :global(p:first-child) {
      font-size: 17px;
      line-height: 1.78;
    }

    .essay-technical-longread .essay-body :global(h2) {
      margin-top: var(--space-56);
      padding-top: var(--space-24);
    }

    .essay-technical-longread .essay-body :global(h2:first-of-type) {
      margin-top: var(--space-48);
      padding-top: 0;
    }

    .essay-technical-longread .essay-body :global(h3) {
      margin-top: var(--space-32);
    }

    .essay-technical-longread .essay-body :global(p:has(> img:only-child)),
    .essay-technical-longread .essay-body :global(figure) {
      margin-block: var(--space-28);
    }

    .essay-technical-longread .essay-body :global(img) {
      max-height: none;
    }


  }
</style>

<script is:inline>
  (() => {
    const links = Array.from(document.querySelectorAll('.essay-toc-link'));
    if (!links.length) return;

    links.forEach(link => link.addEventListener('click', () => {
      const disclosure = link.closest('details');
      if (disclosure) disclosure.open = false;
    }));

    const uniqueLinks = links.filter((link, index) => links.findIndex(other => other.getAttribute('href') === link.getAttribute('href')) === index);
    const items = uniqueLinks
      .map((link) => {
        const id = decodeURIComponent(link.getAttribute('href')?.slice(1) ?? '');
        return {
          link,
          heading: document.getElementById(id),
        };
      })
      .filter((item) => item.heading);

    if (!items.length) return;

    const setActive = (activeLink) => {
      links.forEach((link) => {
        const isActive = link.getAttribute('href') === activeLink.getAttribute('href');
        link.classList.toggle('is-active', isActive);
        if (isActive) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    const updateActive = () => {
      const pivot = window.innerHeight * 0.22;
      let active = items[0];

      items.forEach((item) => {
        if (item.heading.getBoundingClientRect().top <= pivot) {
          active = item;
        }
      });

      setActive(active.link);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        updateActive();
        ticking = false;
      });
    };

    updateActive();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  })();
</script>
