		<Analytics />
		<script is:inline>
			(() => {
				const header = document.querySelector('.site-header');
				if (!header) return;

				let previousY = window.scrollY;
				let ticking = false;

				const updateHeader = () => {
					const currentY = window.scrollY;
					const isScrollingDown = currentY > previousY;

					if (currentY < 40 || !isScrollingDown) {
						header.classList.remove('is-hidden');
						header.classList.toggle('is-elevated', currentY >= 40);
					} else if (currentY > 96 && currentY - previousY > 4) {
						header.classList.add('is-hidden');
						header.classList.remove('is-elevated');
					}

					previousY = currentY;
					ticking = false;
				};

				window.addEventListener(
					'scroll',
					() => {
						if (ticking) return;
						ticking = true;
						window.requestAnimationFrame(updateHeader);
					},
					{ passive: true }
				);
			})();
		</script>
