---
import Analytics from "@vercel/analytics/astro";

const {
  title = "路遥知玛丽",
  description = "一个产品设计师，会点儿吉他，喜欢摄影，最近在研究 Ai。",
  ogImage = "/og-cover.jpg",
  lang = "zh-CN"
} = Astro.props;

const siteUrl = Astro.site?.origin ?? "https://luyao.studio";
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageVersion = "2";
const ogImageUrl = new URL(ogImage, siteUrl);
ogImageUrl.searchParams.set("v", ogImageVersion);
const isReadingPage = ['/essays/', '/design-study/'].some(
	(prefix) => Astro.url.pathname.startsWith(prefix) && Astro.url.pathname !== prefix,
);
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/avatar.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="路遥知玛丽" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="路遥知玛丽 · 个人站" />
		<meta property="og:site_name" content="路遥知玛丽 · 个人站" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<header class="site-header" data-reading-header={isReadingPage ? 'true' : 'false'}>
			<a href="/" class="brand brand-link">路遥知玛丽</a>
			<nav class="site-nav" aria-label="主导航">
				<a href="/" class={Astro.url.pathname === '/' ? 'is-active' : ''}>Home</a>
				<a href="/work" class={Astro.url.pathname.startsWith('/work') ? 'is-active' : ''}>Work</a>
				<a href="/design-study" class={Astro.url.pathname.startsWith('/design-study') ? 'is-active' : ''}>Design Study</a>
				<a href="/ai-design" class={Astro.url.pathname.startsWith('/ai-design') ? 'is-active' : ''}>Ai-practice</a>
				<a href="/ai" class={Astro.url.pathname.startsWith('/ai') && !Astro.url.pathname.startsWith('/ai-design') ? 'is-active' : ''}>Ai-image</a>
				<a href="/essays" class={Astro.url.pathname.startsWith('/essays') ? 'is-active' : ''}>Essays</a>
				<a href="/photography" class={Astro.url.pathname.startsWith('/photography') ? 'is-active' : ''}>Photography</a>
				<a href="/play" class={Astro.url.pathname.startsWith('/play') ? 'is-active' : ''}>Play</a>
				<a href="/about" class={Astro.url.pathname.startsWith('/about') ? 'is-active' : ''}>About</a>
			</nav>
		</header>
		<main class="site-main">
			<slot />
		</main>
		<footer class="site-footer">
			<p>&copy; {new Date().getFullYear()} 路遥知玛丽</p>
