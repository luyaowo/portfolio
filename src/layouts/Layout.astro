<style>
	@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400..800&display=swap');

	:global(:root) {
		--font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Noto Sans SC', sans-serif;
		--font-heading: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Noto Sans SC', sans-serif;
		--font-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace;
		--font-brand: clamp(18px, 2.4vw, 26px);

		--weight-normal: 400;
		--weight-medium: 500;
		--weight-semibold: 600;
		--weight-bold: 700;

		--text-body: 18px;
		--text-article-body: 17px;
		--text-heading-1: 30px;
		--text-heading-2: 24px;
		--text-heading-3: 20px;
		--text-title-article: clamp(32px, 4.2vw, 40px);
		--text-title-page: clamp(28px, 4vw, 42px);
		--text-title-card: clamp(18px, 1.7vw, 22px);
		--text-summary: 16px;
		--text-intro: 14px;
		--text-meta: 13px;
		--text-caption: 12px;

		--leading-body: 1.82;
		--leading-article-body: 1.72;
		--leading-article-heading: 1.35;
		--leading-title-article: 1.22;
		--leading-heading: 1.45;
		--leading-title: 1.28;
		--leading-text: 1.7;
		--leading-summary: 1.62;
		--leading-meta: 1.4;

		--color-bg: #f7f6f2;
		--color-surface: #fbfaf7;
		--color-surface-white: #ffffff;
		--color-text: rgba(48, 48, 46, 0.94);
		--color-text-heading: rgba(20, 20, 19, 0.99);
		--color-text-secondary: rgba(94, 93, 89, 0.82);
		--color-text-tertiary: rgba(94, 93, 89, 0.58);
		--color-text-inverse: rgba(248, 245, 237, 0.96);
		--color-border: rgba(94, 93, 89, 0.14);
		--color-border-strong: rgba(94, 93, 89, 0.22);
		--color-interactive: rgba(20, 20, 19, 0.98);
		--color-hover: rgba(94, 93, 89, 0.055);
		--color-pressed: rgba(94, 93, 89, 0.09);
		--color-code: rgba(94, 93, 89, 0.08);
		--color-code-block: #181922;
		--color-code-block-text: #f6f3ea;
		--color-link: #8f4a38;
		--color-link-hover: #6f3528;
		--color-link-underline: rgba(143, 74, 56, 0.28);
		--color-link-underline-hover: rgba(111, 53, 40, 0.56);

		--shadow-float: 0 8px 24px rgba(29, 31, 42, 0.06);
		--shadow-float-soft: 0 6px 18px rgba(29, 31, 42, 0.045);
		--radius-sm: 4px;
		--radius-md: 8px;
		--radius-lg: 10px;
		--radius-xl: 12px;

		--width-content: 980px;
		--width-content-narrow: 760px;
		--width-article: 860px;
		--width-article-text: 712px;
		--width-toc: 260px;

		--space-4: 4px;
		--space-8: 8px;
		--space-12: 12px;
		--space-16: 16px;
		--space-20: 20px;
		--space-24: 24px;
		--space-28: 28px;
		--space-32: 32px;
		--space-40: 40px;
		--space-48: 48px;
		--space-56: 56px;
		--space-64: 64px;
		--space-72: 72px;
		--space-120: 120px;
		--space-article-paragraph: 18px;
		--space-article-media: 28px;
		--size-cover-square: 144px;
		--size-cover-square-md: 128px;
		--divider-subtle: 1px solid var(--color-border);
		--divider-strong: 1px solid var(--color-border-strong);
		--transition-interactive: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
		--translate-interactive-y: -0.5px;
		--opacity-timeline-dot: 0.18;
		--opacity-timeline-dot-active: 0.52;
	}

	:global(html),
	:global(body) {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	:global(body) {
		font-family: var(--font-body);
		background: var(--color-bg);
		color: var(--color-text);
		letter-spacing: 0.04em;
	}

	:global(.site-header) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		box-sizing: border-box;
		min-height: var(--space-56);
		padding: 12px var(--space-56);
		background: color-mix(in srgb, var(--color-bg) 72%, transparent);
		border-bottom: 1px solid transparent;
		box-shadow: none !important;
		transform: translateY(0);
		transition: transform 0.24s ease, box-shadow 0.2s ease;
		backdrop-filter: blur(16px) saturate(120%);
		-webkit-backdrop-filter: blur(16px) saturate(120%);
	}

	:global(.site-header.is-hidden) {
		transform: translateY(-100%);
	}

	:global(.site-header.is-elevated) {
		background: color-mix(in srgb, var(--color-bg) 86%, transparent);
		border-bottom-color: var(--color-border);
		box-shadow: var(--shadow-float) !important;
	}

	:global(.brand) {
		font-family: var(--font-heading);
		font-size: var(--font-brand);
		letter-spacing: 0;
		color: var(--color-text-heading);
		font-weight: var(--weight-semibold);
	}

	:global(.brand-link) {
		text-decoration: none;        /* remove any default underline */
		border-bottom: 0;             /* no line in normal state */
		padding-bottom: var(--space-4);
	}

	:global(.brand-link:hover),
	:global(.brand-link:focus-visible) {
		opacity: 0.88;
	}

