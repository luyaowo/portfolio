---
import { getCollection } from 'astro:content';
interface Props {
  collection: 'essays' | 'ai-design' | 'design-study' | 'work';
  excludeSlug?: string;
  limit?: number;
  heading?: string;
}
const { collection, excludeSlug, limit = 2, heading = '继续阅读' } = Astro.props;
const posts = await getCollection(collection);
const suggestions = posts.filter(post => post.slug !== excludeSlug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, limit);
---
{suggestions.length > 0 && (
  <section class="recent-articles" aria-label={heading}>
    <h2>{heading}</h2>
    <ul>
      {suggestions.map(post => (
        <li><a href={`/${post.collection}/${post.slug}`}>
          <span>{post.data.title}</span>
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('zh-CN')}</time>
        </a></li>
      ))}
    </ul>
  </section>
)}
<style>
  .recent-articles { margin-top: var(--space-56); border-top: var(--divider-subtle); padding-top: var(--space-24); }
  h2 { font-size: var(--text-summary); font-weight: var(--weight-medium); margin: 0 0 var(--space-16); color: var(--color-text-secondary); }
  ul { list-style: none; padding: 0; margin: 0; }
  a { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-20); padding: var(--space-12) 0; color: var(--color-text); text-decoration: none; font-size: var(--text-summary); line-height: var(--leading-text); letter-spacing: 0; }
  a:hover span { text-decoration: underline; text-underline-offset: 4px; }
  time { flex-shrink: 0; font-size: var(--text-meta); color: var(--color-text-secondary); }
  @media (max-width: 720px) { a { flex-direction: column; gap: var(--space-4); } }
</style>
