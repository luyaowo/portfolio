---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props {
  title: string;
  description: string;
  collection: 'essays' | 'ai-design' | 'design-study';
  posts: Array<CollectionEntry<'essays'> | CollectionEntry<'ai-design'> | CollectionEntry<'design-study'>>;
  /** 提供网格/列表切换;默认列表视图 */
  toggle?: boolean;
}
const { title, description, collection, posts, toggle = false } = Astro.props;
const defaultView = 'list';
/** 优先按 frontmatter 的 order 字段排序(手动顺序),否则按 date 降序 */
const sortedPosts = [...posts].sort((a, b) => {
  const ao = (a.data as { order?: number }).order;
  const bo = (b.data as { order?: number }).order;
  if (typeof ao === 'number' && typeof bo === 'number') return ao - bo;
  if (typeof ao === 'number') return -1;
  if (typeof bo === 'number') return 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
const formatDate = (date: Date) => date.toLocaleDateString('zh-CN');
---
<Layout title={`${title} · 路遥知玛丽`} description={description}>
  <section class="list-page" data-collection={collection} data-default-view={defaultView}>
    <header class="list-header">
      <div class="header-row">
        <div class="header-text">
          <h1>{title}</h1>
          <p class="intro"><slot /></p>
        </div>
        {toggle && (
          <div class="view-toggle" role="group" aria-label="视图切换">
            <button type="button" class="toggle-btn" data-view="grid" aria-pressed="true" title="网格视图" aria-label="网格视图">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M1 1h6v6H1V1zm8 0h6v6H9V1zM1 9h6v6H1V9zm8 0h6v6H9V9z" />
              </svg>
            </button>
            <button type="button" class="toggle-btn" data-view="list" aria-pressed="false" title="列表视图" aria-label="列表视图">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path d="M2 2h12v2.5H2V2zm0 4.75h12v2.5H2v-2.5zm0 4.75h12V14H2v-2.5z" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </header>
    {sortedPosts.length === 0 && <p class="empty-state">文章整理中。</p>}
    <section class:list={['item-list', { 'is-grid': toggle && defaultView === 'grid' }]} aria-label="文章列表">
      {sortedPosts.map((post) => (
        <article>
          <a class:list={['item-link', { 'without-cover': !post.data.cover }]} href={`/${collection}/${post.slug}`}>
            {post.data.cover && (
              <figure class:list={['cover', { contain: collection !== 'essays' }]}>
                <Image src={post.data.cover} alt="" widths={[160, 320, 640, 960]}
                  sizes="(max-width: 720px) calc(100vw - 80px), 144px" format="webp" quality={80}
                  loading="lazy" decoding="async" />
              </figure>
            )}
            <div class="content">
              <div class="text">
                <h2 class="title">{post.data.title}</h2>
                {post.data.summary && <p class="summary">{post.data.summary}</p>}
              </div>
              <footer class="meta">
                <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                {'views' in post.data && typeof post.data.views === 'number' && <span>{post.data.views} 浏览</span>}
              </footer>
            </div>
          </a>
        </article>
      ))}
    </section>
  </section>

  {toggle && (
    <script is:inline>
      (() => {
        const root = document.querySelector('.list-page');
        if (!root) return;
        const buttons = root.querySelectorAll('.toggle-btn');
        const list = root.querySelector('.item-list');
        const key = 'list-view-' + root.dataset.collection;
        const apply = (view) => {
          list.classList.toggle('is-grid', view === 'grid');
          buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.view === view ? 'true' : 'false'));
          try { localStorage.setItem(key, view); } catch {}
        };
        let saved = null;
        try { saved = localStorage.getItem(key); } catch {}
        apply(saved || root.dataset.defaultView);
        buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.view)));
      })();
    </script>
  )}
</Layout>

<style>
  .list-page {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--width-content-narrow);
    margin: var(--space-56) auto var(--space-120);
    padding: 0 var(--space-20);
  }

  .list-header {
    margin-bottom: var(--space-48);
  }

  .header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .header-text {
    min-width: 0;
  }

  .view-toggle {
    display: flex;
    flex-shrink: 0;
    padding: var(--space-4);
    gap: var(--space-4);
    border: var(--divider-subtle);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }

  .toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 24px;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-tertiary);
    cursor: pointer;
  }

  .toggle-btn:hover {
    color: var(--color-text-primary);
  }

  .toggle-btn[aria-pressed="true"] {
    background: var(--color-hover);
    color: var(--color-text-primary);
  }

  .list-header h1 {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-page);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-12);
  }

  .intro {
    margin: 0;
    font-size: var(--text-summary);
    line-height: var(--leading-text);
    color: var(--color-text-secondary);
  }

  .item-list {
    display: grid;
    gap: var(--space-48);
  }

  .empty-state {
    margin: 0;
    padding-top: var(--space-24);
    border-top: var(--divider-subtle);
    color: var(--color-text-secondary);
    font-size: var(--text-summary);
  }

  .item-link.without-cover {
    grid-template-columns: 1fr;
  }

  .without-cover .content {
    min-height: auto;
  }

  .item-link {
    display: grid;
    grid-template-columns: var(--size-cover-square) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: start;
    color: inherit;
    text-decoration: none;
  }

  .cover {
    margin: 0;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-hover);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cover.contain img { object-fit: contain; }

  .content {
    min-width: 0;
    display: grid;
    align-content: space-between;
    min-height: var(--size-cover-square);
  }

  .text {
    padding-top: 1px;
  }

  .title {
    margin: 0;
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--text-title-card);
    line-height: var(--leading-summary);
    font-weight: var(--weight-medium);
    letter-spacing: 0;
    text-wrap: balance;
  }

  .summary {
    margin: var(--space-8) 0 0;
    color: var(--color-text-secondary);
    font-family: var(--font-heading);
    font-size: var(--text-summary);
    line-height: var(--leading-summary);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-16);
    margin-top: var(--space-8);
    color: var(--color-text-tertiary);
    font-size: var(--text-meta);
    line-height: var(--leading-meta);
  }

  .date {
    white-space: nowrap;
  }

  .item-link:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: var(--space-4);
  }

  /* 网格视图:一行三卡 */
  .item-list.is-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-32) var(--space-24);
  }

  .is-grid .item-link {
    display: block;
  }

  .is-grid .cover {
    aspect-ratio: 16 / 10;
    margin-bottom: var(--space-12);
  }

  .is-grid .content {
    display: block;
    min-height: auto;
  }

  .is-grid .title {
    font-size: var(--text-title-card);
  }

  .is-grid .summary {
    display: none;
  }

  .is-grid .meta {
    margin-top: var(--space-8);
    justify-content: flex-start;
  }

  @media (max-width: 960px) {
    .list-page {
      padding: 0 var(--space-20);
    }

    .item-link {
      grid-template-columns: var(--size-cover-square-md) minmax(0, 1fr);
      gap: var(--space-16);
    }

    .content {
      min-height: var(--size-cover-square-md);
    }

    .summary {
      font-size: var(--text-summary);
    }

    .meta {
      font-size: var(--text-caption);
    }

    .item-list.is-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .list-page {
      margin-top: var(--space-28);
      padding: 0 var(--space-16);
    }

    .list-header {
      margin-bottom: var(--space-28);
    }

    .item-link {
      grid-template-columns: 1fr;
      gap: var(--space-16);
    }

    .item-list.is-grid {
      grid-template-columns: 1fr;
    }

    .header-row {
      flex-direction: column;
    }

    .cover {
      aspect-ratio: 16 / 10;
    }

    .content {
      min-height: auto;
      gap: var(--space-16);
    }

    .title {
      font-size: var(--text-heading-3);
    }

    .summary {
      font-size: var(--text-summary);
      line-height: var(--leading-text);
      margin-top: var(--space-8);
    }

    .meta {
      font-size: var(--text-meta);
      margin-top: 0;
    }
  }
</style>
